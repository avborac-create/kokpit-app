// KOKPIT APP - Prisma Semasi
//
// Mimari not: Bu sema iki katmandan olusur:
//   1) CEKIRDEK (Core)   - tum modullerin ortak kullandigi altyapi
//                          (kullanicilar, rolleri; genisletilebilir secenek listeleri)
//   2) MODUL             - her modul kendi tablolarini bu dosyaya ekler, ama
//                          mumkun oldugunca diger modullerin ic yapisina dogrudan
//                          FK ile baglanmaz (bkz. ARCHITECTURE.md - "gevsek baglilik").
//
// Yeni bir modul eklerken:
//   - Yeni tablolarini bu dosyanin sonuna, ayri bir "MODUL: <isim>" blogu olarak ekle.
//   - "durum", "tip" gibi kategori alanlari icin SecenekListesi/SecenekDegeri
//     desenini kullan; yeni bir enum TANIMLAMA. Yeni bir deger eklemek bir veri
//     satiri eklemek olsun, semayi degistirmek olmasin.
//   - Baska bir modulun kaydina referans gerekiyorsa (orn. "ilgili dosya"),
//     once o modul yoksa serbest metin/opsiyonel id alani olarak birak,
//     modul eklenince FK'ya (gerekirse coka-cok ara tabloya) cevir - bkz.
//     ParaTrafigiDosyasi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Vercel'in "Prisma Postgres" entegrasyonu DATABASE_URL'i otomatik olusturur
  // ve havuzlama (pooling) kendi altyapisinda halleder; ayri bir DIRECT_URL
  // gerekmez.
  url      = env("DATABASE_URL")
}

// ============================================================
// CEKIRDEK (CORE)
// ============================================================

enum KullaniciRolu {
  YONETICI // sistem yonetici - tam yetki
  ORTAK // buro ortagi
  SORUMLU_AVUKAT // dosya/musteri sorumlusu avukat
  PERSONEL // diger buro personeli

  @@map("kullanici_rolu")
}

model Kullanici {
  id               String        @id @default(cuid())
  adSoyad          String
  eposta           String        @unique
  sifreHash        String
  rol              KullaniciRolu @default(PERSONEL)
  aktifMi          Boolean       @default(true)
  olusturmaTarihi  DateTime      @default(now())
  guncellemeTarihi DateTime      @updatedAt

  sorumluOlduguMusteriler        Musteri[]          @relation("MusteriSorumluAvukat")
  sorumluOlduguDosyalar          DavaDosyasi[]      @relation("DavaDosyasiSorumluAvukat")
  gonderdigiOneriler             Oneri[]
  gonderdigiGelistirmeTalepleri  GelistirmeTalebi[]
  sorumluOlduguHukukiMudahaleler HukukiMudahale[]   @relation("HukukiMudahaleSorumluAvukat")

  @@map("kullanicilar")
}

// Genisletilebilir liste/etiket altyapisi.
// "durum", "tip", "kaynak" gibi kategori alanlari icin kullanilir; boylece
// yeni bir deger eklemek (orn. "kismi tahsilat") semayi bozmadan, sadece
// yeni bir SecenekDegeri satiri eklemekle yapilir.
model SecenekListesi {
  id       String  @id @default(cuid())
  anahtar  String  @unique // orn. "musteri_tipi", "musteri_durumu", "para_trafigi_tipi"
  ad       String // insan-okunur ad, orn. "Musteri Tipi"
  aciklama String?

  degerler SecenekDegeri[]

  @@map("secenek_listeleri")
}

model SecenekDegeri {
  id              String         @id @default(cuid())
  listeId         String
  liste           SecenekListesi @relation(fields: [listeId], references: [id], onDelete: Cascade)
  kod             String // makine-okunur anahtar, orn. "gercek_kisi"
  etiket          String // ekranda gosterilen ad, orn. "Gerçek Kişi"
  siraNo          Int            @default(0)
  aktifMi         Boolean        @default(true)
  olusturmaTarihi DateTime       @default(now())

  musterilerTip                 Musteri[]             @relation("MusteriTipi")
  musterilerDurum               Musteri[]             @relation("MusteriDurumu")
  paraTrafigiTip                MusteriParaTrafigi[]  @relation("ParaTrafigiTipi")
  paraTrafigiDurum              MusteriParaTrafigi[]  @relation("ParaTrafigiDurumu")
  paraTrafigiKaynak             MusteriParaTrafigi[]  @relation("ParaTrafigiKaynagi")
  davaDosyalariDurum            DavaDosyasi[]         @relation("DavaDosyasiDurumu")
  davaDosyalariTuru             DavaDosyasi[]         @relation("DavaDosyasiTuru")
  davaDosyalariHukukiIliskiTuru DavaDosyasi[]         @relation("DavaDosyasiHukukiIliskiTuru")
  paraTrafigiTasnifCariKod      ParaTrafigiTasnif[]   @relation("ParaTrafigiTasnifCariKod")
  dosyaMasrafiCariKod           DosyaMasrafi[]        @relation("DosyaMasrafiCariKod")
  dosyaMasrafiTuru              DosyaMasrafi[]        @relation("DosyaMasrafiTuru")
  dosyaMasrafiDurum             DosyaMasrafi[]        @relation("DosyaMasrafiDurumu")
  gelistirmeTalepleriDurum      GelistirmeTalebi[]    @relation("GelistirmeTalebiDurumu")
  uyusmazlikGrubuDurum          UyusmazlikGrubu[]     @relation("UyusmazlikGrubuDurumu")
  paraTrafigiSahiplik           MusteriParaTrafigi[]  @relation("ParaKaydiSahibi")
  paraKaydiKullanimAmaci        ParaTrafigiDagitimi[] @relation("ParaKaydiKullanimAmaci")
  hukukiMudahaleTuru            HukukiMudahale[]      @relation("HukukiMudahaleTuru")
  hukukiMudahaleOnceligi        HukukiMudahale[]      @relation("HukukiMudahaleOnceligi")
  hacizRaporuMuhafaza           HacizRaporu[]         @relation("HacizRaporuMuhafaza")
  hacizRaporuIstihkak           HacizRaporu[]         @relation("HacizRaporuIstihkak")
  hacizRaporuKiymetTakdiri      HacizRaporu[]         @relation("HacizRaporuKiymetTakdiri")

  @@unique([listeId, kod])
  @@map("secenek_degerleri")
}

// ============================================================
// MODUL: Musteri Veritabani (Müvekkil İlişkileri)
// ============================================================

// Musteri Fihristi
model Musteri {
  id               String        @id @default(cuid())
  adSoyadUnvan     String
  tipId            String
  tip              SecenekDegeri @relation("MusteriTipi", fields: [tipId], references: [id])
  telefon          String?
  eposta           String?
  adres            String?
  durumId          String
  durum            SecenekDegeri @relation("MusteriDurumu", fields: [durumId], references: [id])
  sorumluAvukatId  String?
  sorumluAvukat    Kullanici?    @relation("MusteriSorumluAvukat", fields: [sorumluAvukatId], references: [id])
  notlar           String?
  olusturmaTarihi  DateTime      @default(now())
  guncellemeTarihi DateTime      @updatedAt

  paraTrafigi        MusteriParaTrafigi[]
  dosyalar           DosyaMuvekkili[]
  irtibatKisileri    IrtibatKisisi[]
  karsiTaraflar      KarsiTaraf[]
  uyusmazlikGruplari UyusmazlikGrubu[]
  finansHareketleri  MusteriFinansHareketi[]
  cmkDosyalari       CMKDosyasi[]

  @@index([durumId])
  @@index([sorumluAvukatId])
  @@map("musteriler")
}

// Musterinin (ozellikle tuzel kisilerin) irtibat kisileri/temsilcileri.
// Hangi konuda hangi kisiyle irtibata gecilecegini kayit altina alir;
// telefon/e-posta gibi iletisim bilgileri her zaman bir kisiye bagli
// tutulur, boylece "bu numara/e-posta kime ait" belirsizligi olmaz.
model IrtibatKisisi {
  id        String  @id @default(cuid())
  musteriId String
  musteri   Musteri @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  adSoyad     String
  unvanGorev  String? // "Genel Müdür", "Muhasebe Sorumlusu" vb.
  konuBasligi String? // hangi konularda irtibat kurulmali - "Sözleşme onayları" vb.
  telefon     String?
  eposta      String?
  birincilMi  Boolean @default(false) // ilk/asil irtibat kisisi mi
  notlar      String?

  olusturmaTarihi DateTime @default(now())

  @@index([musteriId])
  @@map("irtibat_kisileri")
}

// Musteri Para Trafigi (Musteri Fihristi'ne bagli, 1 musteri -> cok kayit)
// Ileride Finans/Muhasebe modulune dogrudan baglanacak sekilde tasarlandi.
model MusteriParaTrafigi {
  id        String  @id @default(cuid())
  musteriId String
  musteri   Musteri @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  tarih    DateTime
  tipId    String
  tip      SecenekDegeri @relation("ParaTrafigiTipi", fields: [tipId], references: [id])
  tutar    Decimal       @db.Decimal(14, 2)
  aciklama String?

  durumId String
  durum   SecenekDegeri @relation("ParaTrafigiDurumu", fields: [durumId], references: [id])

  // manuel / uyap_import / objekt - ileride toplu import icin
  kaynakId String
  kaynak   SecenekDegeri @relation("ParaTrafigiKaynagi", fields: [kaynakId], references: [id])

  // Bir kayit (orn. bir tahsilat) birden fazla dava dosyasina istinaden
  // gelmis olabilir (bazen tek, bazen cok dosya soz konusu olur) - bkz.
  // ParaTrafigiDosyasi ara tablosu.
  dosyalar ParaTrafigiDosyasi[]

  // Musterinin ayirt edici unsuru (ör. "Asya Park Ticareti") - opsiyonel.
  // Musteriden gelen bir para her zaman somut bir dava dosyasina
  // baglanabilecek durumda olmayabilir (henuz dosya acilmamis olabilir),
  // ama HANGI ticari iliskiye/uyusmazliga ait oldugu bilinebilir. Bu alan
  // dosya secimi olmadan da grubun cari hesabina dahil olmayi saglar.
  uyusmazlikGrubuId String?
  uyusmazlikGrubu   UyusmazlikGrubu? @relation(fields: [uyusmazlikGrubuId], references: [id])

  // Gelen tutarin cari kodlara (Bloke Paralar / Masraf Hesabi / Akdi Vekalet
  // Hesabi / Ticari Hesap vb.) nasil dagitildigi - bkz. ParaTrafigiTasnif.
  tasnif ParaTrafigiTasnif[]

  // Paranin sahibi: Muvekkil mi, Buro mu (ör. Vekalet Ucreti kaydi burada
  // esasen buronun kendi geliridir). Nullable: gecmis kayitlar hep
  // muvekkile ait sayiliyordu, yeni kayitlarda formda varsayilan "Muvekkil".
  sahiplikId String?
  sahiplik   SecenekDegeri? @relation("ParaKaydiSahibi", fields: [sahiplikId], references: [id])

  // Dekont/belge baglantisi - V1: gercek dosya yukleme degil, serbest
  // metin/URL referansi (bkz. ARCHITECTURE.md "Masraf Belgesi Ekleri" -
  // gercek dosya depolama bilincli olarak ERTELENDI).
  belgeReferansi String?

  // "Muvekkilden Para Geldi" kaydinin (header) birden fazla Dosya
  // Kumesine/kaleme boluşturulmesi - bkz. ParaTrafigiDagitimi. Bos
  // olabilir (kume secilmeden genel tahsilat girilebilir, sonradan
  // dagitilir).
  dagitimlar ParaTrafigiDagitimi[]

  olusturmaTarihi DateTime @default(now())

  @@index([musteriId])
  @@index([durumId])
  @@index([uyusmazlikGrubuId])
  @@index([sahiplikId])
  @@map("musteri_para_trafigi")
}

// Tek bir "Muvekkilden Para Geldi" kaydinin (header, MusteriParaTrafigi)
// birden fazla Dosya Kumesine ve farkli kullanim amaclarina bolunmesi
// (ör. 172.984,89 TL tahsilat -> 43.984,89 TL gecmis masraf + 114.000 TL
// vekalet ucreti + 15.000 TL dosya avansi, farkli kumelere). Sadece bu
// akista kullanilir - diger tipler (Bloke Para Yatirdik, Vekalet Ucreti
// Ekledik vb.) tekil uyusmazlikGrubuId alanini kullanmaya devam eder.
model ParaTrafigiDagitimi {
  id            String             @id @default(cuid())
  paraTrafigiId String
  paraTrafigi   MusteriParaTrafigi @relation(fields: [paraTrafigiId], references: [id], onDelete: Cascade)

  uyusmazlikGrubuId String
  uyusmazlikGrubu   UyusmazlikGrubu @relation(fields: [uyusmazlikGrubuId], references: [id])

  // Kumenin geneline ait olabilir (dosya secilmez) - ör. henuz hangi
  // dosyaya harcanacagi belli olmayan bir vekalet ucreti tahsilati.
  dosyaId String?
  dosya   DavaDosyasi? @relation(fields: [dosyaId], references: [id])

  kullanimAmaciId String
  kullanimAmaci   SecenekDegeri @relation("ParaKaydiKullanimAmaci", fields: [kullanimAmaciId], references: [id])

  tutar Decimal @db.Decimal(14, 2)

  olusturmaTarihi DateTime @default(now())

  @@index([paraTrafigiId])
  @@index([uyusmazlikGrubuId])
  @@index([dosyaId])
  @@index([kullanimAmaciId])
  @@map("para_trafigi_dagitimi")
}

// Bir para trafigi kaydinin (ozellikle bir tahsilatin) cari kodlara gore
// tasnifi/dagitimi. Orn. 330.000 TL'lik bir tahsilat; 285.000 Bloke Paralar,
// 30.000 Masraf Hesabi, 15.000 Akdi Vekalet Hesabi olarak boluneilir. Toplam,
// kaydin tutariyla mutabik olmak ZORUNDA degil (UI'da kontrol/uyari olarak
// gosterilir) - gercek hayatta tasnif sonradan da tamamlanabilir.
model ParaTrafigiTasnif {
  id            String             @id @default(cuid())
  paraTrafigiId String
  paraTrafigi   MusteriParaTrafigi @relation(fields: [paraTrafigiId], references: [id], onDelete: Cascade)
  cariKodId     String
  cariKod       SecenekDegeri      @relation("ParaTrafigiTasnifCariKod", fields: [cariKodId], references: [id])
  tutar         Decimal            @db.Decimal(14, 2)

  olusturmaTarihi DateTime @default(now())

  @@unique([paraTrafigiId, cariKodId])
  @@index([cariKodId])
  @@map("para_trafigi_tasnif")
}

// MusteriParaTrafigi <-> DavaDosyasi coka-cok iliski (ara) tablosu. Ileride
// "tasnif" adimi bu satirlara dosya basina tutar/pay eklenerek genisleyebilir.
model ParaTrafigiDosyasi {
  id            String             @id @default(cuid())
  paraTrafigiId String
  paraTrafigi   MusteriParaTrafigi @relation(fields: [paraTrafigiId], references: [id], onDelete: Cascade)
  dosyaId       String
  dosya         DavaDosyasi        @relation(fields: [dosyaId], references: [id], onDelete: Cascade)

  olusturmaTarihi DateTime @default(now())

  @@unique([paraTrafigiId, dosyaId])
  @@index([dosyaId])
  @@map("para_trafigi_dosyalari")
}

// ============================================================
// MODUL: Dava Dosyalari
// ============================================================

// Musterinin (muvekkilin) KENDI musterisi/borclusu - buronun muvekkil adina
// icra/dava takip ettigi karsi taraf (orn. "Koz Gida", "Nasip Sac"). Musteri
// (muvekkil) ile KARISTIRILMAMALI - bkz. ARCHITECTURE.md "Finans Modulu"
// bolumu. Bir karsi tarafa birden fazla dava dosyasi baglanabilir.
model KarsiTaraf {
  id        String  @id @default(cuid())
  musteriId String
  musteri   Musteri @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  ad             String
  tanimlayiciKod String? // MAK: cek no, VKN vb. - simdilik serbest metin (bkz. ARCHITECTURE.md)
  notlar         String?

  olusturmaTarihi DateTime @default(now())

  dosyalar DosyaKarsiTarafi[]
  kumeler  UyusmazlikGrubuKarsiTarafi[]

  @@index([musteriId])
  @@map("karsi_taraflar")
}

// DavaDosyasi <-> KarsiTaraf coka-cok ara tablosu (DosyaMuvekkili ile
// aynı desen). Bir icra takibi genelde TEK bir karsi tarafa degil, cek/
// bono zincirindeki TUM muteselsil sorumlulara (kesideci + cirantalar)
// birden acilir - ayni esas dosyada birden fazla borclu birlikte takip
// edilir (bkz. ARCHITECTURE.md).
model DosyaKarsiTarafi {
  id           String      @id @default(cuid())
  dosyaId      String
  dosya        DavaDosyasi @relation(fields: [dosyaId], references: [id], onDelete: Cascade)
  karsiTarafId String
  karsiTaraf   KarsiTaraf  @relation(fields: [karsiTarafId], references: [id], onDelete: Cascade)

  olusturmaTarihi DateTime @default(now())

  @@unique([dosyaId, karsiTarafId])
  @@index([karsiTarafId])
  @@map("dosya_karsi_taraflari")
}

// Ayni alacagin/uyusmazligin tahsili icin birden fazla karsi taraf ve dosya
// gerekebilir (orn. asil borclu + sonradan devreye giren kefil/senet
// dosyasi, "tekerrur olmasin" notuyla birbirine bagli). UyusmazlikGrubu bu
// ust gruplamayi temsil eder: "Asya Park Ticareti" gibi tek bir kok
// alacak/uyusmazlik, altinda birden fazla Uyusmazlik Dosyasi (DavaDosyasi)
// barindirabilir.
model UyusmazlikGrubu {
  id        String  @id @default(cuid())
  musteriId String
  musteri   Musteri @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  ad     String // "Asya Park Ticareti", "Hicret Kırtay İş Sözleşmesi" vb.
  notlar String?

  // UI'da "Dosya Kümesi" olarak gösterilir (model/tablo adi degismedi -
  // zaten var olan bir kavramin tamamlanmasi, bkz. ARCHITECTURE.md).
  // dava_dosyasi_durumu listesi YENIDEN KULLANILIR (Acik/Kapali/Arsiv) -
  // semantik birebir ayni, ayri bir liste acmaya gerek yok. Nullable:
  // eski kayitlar NULL kalir, UI bunu "Acik" gibi gosterir.
  durumId String?
  durum   SecenekDegeri? @relation("UyusmazlikGrubuDurumu", fields: [durumId], references: [id])

  olusturmaTarihi DateTime @default(now())

  dosyalar             DavaDosyasi[]
  paraTrafigiKayitlari MusteriParaTrafigi[]
  // Kumenin "genel/bilinen" karsi taraflari - her yargisal dosyanin KENDI
  // karsi taraf listesi (DosyaKarsiTarafi) bagimsiz kalir ve bundan farkli
  // olabilir (ör. esas icra 3 kisiye, icra ceza sadece 1'ine acik) - bu
  // liste sadece kume seviyesinde bir ozet/on-doldurma amaclidir.
  karsiTaraflar        UyusmazlikGrubuKarsiTarafi[]
  dagitimlar           ParaTrafigiDagitimi[]

  @@index([musteriId])
  @@index([durumId])
  @@map("uyusmazlik_gruplari")
}

// UyusmazlikGrubu <-> KarsiTaraf coka-cok - DosyaKarsiTarafi ile ayni sekil.
model UyusmazlikGrubuKarsiTarafi {
  id                String          @id @default(cuid())
  uyusmazlikGrubuId String
  uyusmazlikGrubu   UyusmazlikGrubu @relation(fields: [uyusmazlikGrubuId], references: [id], onDelete: Cascade)
  karsiTarafId      String
  karsiTaraf        KarsiTaraf      @relation(fields: [karsiTarafId], references: [id], onDelete: Cascade)

  olusturmaTarihi DateTime @default(now())

  @@unique([uyusmazlikGrubuId, karsiTarafId])
  @@index([karsiTarafId])
  @@map("uyusmazlik_grubu_karsi_taraflari")
}

// Bir dava dosyasina birden fazla musteri baglanabilir (ortak davacilar,
// veraset vb.); bu yuzden Musteri <-> DavaDosyasi iliskisi DosyaMuvekkili
// ara tablosu uzerinden coka-cok kurulur (bkz. semanin en ustundeki not).
model DavaDosyasi {
  id                 String           @id @default(cuid())
  // Kokpit'in kendi ic kayit numarasi - "Dosya No" (mahkeme/icra
  // dairesinin verdigi esas no) artik opsiyonel oldugu icin, HER dosyanin
  // (turu ne olursa olsun - ihtar/muzakere/icra/dava) sistemde her zaman
  // sahip oldugu, otomatik atanan, sirali bir kimlik numarasi. Kullanicinin
  // girmesi gerekmez, "Kokpit No" olarak gosterilir (ör. "KP-0007").
  kayitNo            Int              @unique @default(autoincrement())
  dosyaNo            String?
  birimAdi           String? // Mahkeme/Icra Dairesi adi, orn. "Istanbul 19. Icra Dairesi"
  konu               String
  // Dosya turu: ihtar/arabuluculuk/muzakere gibi dava/icra oncesi
  // asamalari da, esas icra/talimat/dava/icra ceza gibi resmi dosyalari da
  // kapsayan tek bir secenek listesi (bkz. ARCHITECTURE.md). Nullable:
  // eski kayitlar geriye donuk turlendirilene kadar bos kalabilir, ama
  // yeni dosya formunda zorunlu tutulur.
  turId              String?
  tur                SecenekDegeri?   @relation("DavaDosyasiTuru", fields: [turId], references: [id])
  // Alacagin/uyusmazligin dayandigi temel hukuki iliski: cek, senet, TTOK,
  // is hukuku uyusmazligi vb. Dosya Turu'nden (ihtar/icra/dava - hangi
  // ASAMADAYIZ) farkli bir boyut: bu "hangi hukuki ARACA dayaniyor" sorusuna
  // cevap verir. Opsiyonel - her dosyaya uygulanabilir bir siniflandirma
  // olmayabilir.
  hukukiIliskiTuruId String?
  hukukiIliskiTuru   SecenekDegeri?   @relation("DavaDosyasiHukukiIliskiTuru", fields: [hukukiIliskiTuruId], references: [id])
  uyusmazlikGrubuId  String?
  uyusmazlikGrubu    UyusmazlikGrubu? @relation(fields: [uyusmazlikGrubuId], references: [id])
  // Talimat dosyasi gibi baska bir dosyaya siki sikiya bagli (o dosyanin
  // bir uzantisi olan) dosyalar icin: hangi ESAS dosyaya bagli oldugu.
  // UyusmazlikGrubu'ndan farki: grup gevsek bir gruplamadir (ayni alacagin
  // bagimsiz kardes dosyalari - icra ceza, ihtiyati haciz vb.), bu alan ise
  // "bu dosya somut olarak şu belirli dosyanin bir eki/talimatidir" gibi
  // kesin, tekil bir bagi ifade eder.
  bagliOlduguDosyaId String?
  bagliOlduguDosya   DavaDosyasi?     @relation("DosyaBaglantisi", fields: [bagliOlduguDosyaId], references: [id])
  baglananDosyalar   DavaDosyasi[]    @relation("DosyaBaglantisi")
  durumId            String
  durum              SecenekDegeri    @relation("DavaDosyasiDurumu", fields: [durumId], references: [id])
  sorumluAvukatId    String?
  sorumluAvukat      Kullanici?       @relation("DavaDosyasiSorumluAvukat", fields: [sorumluAvukatId], references: [id])
  acilisTarihi       DateTime
  kapanisTarihi      DateTime?
  aciklama           String?
  olusturmaTarihi    DateTime         @default(now())
  guncellemeTarihi   DateTime         @updatedAt

  // ============================================================
  // Karar Sonrasi Takip (bkz. ARCHITECTURE.md "Dava Dosyasi Yasam
  // Dongusu") - hepsi opsiyonel, mevcut kayitlari bozmaz, tahmin/backfill
  // YAPILMAZ. `durumId` (acik/kapali/arsiv - yukarida) BUNDAN BAGIMSIZ:
  // o dosyanin GENEL yonetimsel durumu, `dosyaEvresi` ise hukuki surecin
  // neresinde oldugu. KESINLESTI, durumId'yi otomatik "kapali" yapmaz -
  // kesinlesmis bir dosyada tahsilat/iade gibi artci isler surebilir.
  dosyaEvresi          DosyaEvresi?
  // dosyaEvresi her degistiginde otomatik guncellenir (bkz. actions.ts).
  evreDegisiklikTarihi DateTime?
  sonrakiKontrolTarihi DateTime?
  sonrakiKontrolSorusu String?
  sonKontrolTarihi     DateTime?
  sonKontrolSonucu     String?

  muvekkiller            DosyaMuvekkili[]
  karsiTaraflar          DosyaKarsiTarafi[]
  paraTrafigiKayitlari   ParaTrafigiDosyasi[]
  masraflar              DosyaMasrafi[]
  karsiTarafAlacaklari   KarsiTarafAlacagi[]
  paraTrafigiDagitimlari ParaTrafigiDagitimi[]
  finansHareketleri      MusteriFinansHareketi[]
  hukukiMudahaleler      HukukiMudahale[]
  hacizRaporlari         HacizRaporu[]

  @@index([durumId])
  @@index([sorumluAvukatId])
  @@index([uyusmazlikGrubuId])
  @@index([bagliOlduguDosyaId])
  @@index([turId])
  @@index([hukukiIliskiTuruId])
  @@index([dosyaEvresi])
  @@map("dava_dosyalari")
}

// Muvekkilden gelen para (tasnif/masraf sistemi) ile KARISTIRILMAMALI: bu,
// karsi tarafin (borclunun) dava/icra sonucu bize/muvekkile ayrica
// odemesi gereken bir alacaktir (ör. icra vekalet ucreti, yargilama
// gideri) - cebimizden hicbir sey cikmaz, tersine karsi taraftan bir
// tahsilat beklenir. Muvekkil emanet/cari hesabindan (ParaTrafigiTasnif/
// DosyaMasrafi) BILEREK ayri tutulur (bkz. ARCHITECTURE.md); evrensel
// hukuk burosu pratiginde musteri emanet hesabi (trust account) ile
// buronun/musvekkilin ucuncu taraflardan alacagi hep ayri muhasebelesir.
model KarsiTarafAlacagi {
  id      String      @id @default(cuid())
  dosyaId String
  dosya   DavaDosyasi @relation(fields: [dosyaId], references: [id], onDelete: Cascade)

  tutar    Decimal @db.Decimal(14, 2)
  aciklama String // "İcra vekalet ücreti" vb.

  tahsilEdildiMi Boolean   @default(false)
  tahsilTarihi   DateTime?

  olusturmaTarihi DateTime @default(now())

  @@index([dosyaId])
  @@map("karsi_taraf_alacaklari")
}

// Bir dosyaya iliskin tek tek masraf kalemleri (harc, pul, dava masrafi,
// haciz avansi vb.) - gercek muhasebe dokumlerindeki kalem-kalem yapiyi
// birebir yansitir, boylece muvekkile "paranin nereye gittigi" satir
// satir gosterilebilir. Her kalem, o dosyanin hangi cari koddan
// (Masraf Hesabi, Bloke Paralar vb.) dusuldugunu de tasir.
model DosyaMasrafi {
  id        String        @id @default(cuid())
  dosyaId   String
  dosya     DavaDosyasi   @relation(fields: [dosyaId], references: [id], onDelete: Cascade)
  cariKodId String
  cariKod   SecenekDegeri @relation("DosyaMasrafiCariKod", fields: [cariKodId], references: [id])
  turId     String
  tur       SecenekDegeri @relation("DosyaMasrafiTuru", fields: [turId], references: [id])

  tarih    DateTime
  aciklama String
  tutar    Decimal  @db.Decimal(14, 2)

  // Yanlis girilen bir masraf artik SILINMEK yerine IPTAL EDILEBILIR (bkz.
  // ARCHITECTURE.md) - satir kalici olarak durur, sadece Cari Hesap'a
  // dahil edilmez. Nullable: eski kayitlar NULL kalir, hesaplamada NULL
  // "Odendi" (aktif) sayilir.
  durumId String?
  durum   SecenekDegeri? @relation("DosyaMasrafiDurumu", fields: [durumId], references: [id])

  olusturmaTarihi DateTime @default(now())

  @@index([dosyaId])
  @@index([cariKodId])
  @@index([turId])
  @@index([durumId])
  @@map("dosya_masraflari")
}

// Musteri <-> DavaDosyasi coka-cok iliski (ara) tablosu.
model DosyaMuvekkili {
  id        String      @id @default(cuid())
  dosyaId   String
  dosya     DavaDosyasi @relation(fields: [dosyaId], references: [id], onDelete: Cascade)
  musteriId String
  musteri   Musteri     @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  olusturmaTarihi DateTime @default(now())

  @@unique([dosyaId, musteriId])
  @@index([musteriId])
  @@map("dosya_muvekkilleri")
}

// ============================================================
// CEKIRDEK: Sayfa Onerileri (Geri Bildirim)
// ============================================================

// Kullanicinin herhangi bir sayfada bir bolge secip kisa bir aciklamayla
// gonderdigi tasarim/veri onerisi. Yonetici/Ortak rolunun gonderdigi
// oneriler dogrudan hayata gecirilir; diger roller gonderdiginde
// yoneticiye onay icin sorulur (bkz. ARCHITECTURE.md).
model Oneri {
  id          String    @id @default(cuid())
  kullaniciId String
  kullanici   Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)

  metin      String
  sayfaYolu  String
  gorselVeri String? // secilen bolgenin ekran goruntusu (data:image/jpeg;base64,...)
  islendiMi  Boolean @default(false)

  olusturmaTarihi DateTime @default(now())

  @@index([kullaniciId])
  @@map("oneriler")
}

// ============================================================
// CEKIRDEK: Gelistirici Kutusu (Developer Inbox)
// ============================================================

// Musteri (av. Bora) ile Claude arasindaki gelistirme sohbetinde soylenen
// her istek/fikrin, kod yazilmadan once hemen kaydedildigi basit bir
// bekleme listesi. Oneri modelinden farki: ekran goruntusu/bolge secimi
// gerektirmez, sadece kisa bir metin - konusma sirasinda hizlica not
// dusmek icindir. Sira sira, durumu "beklemede"den "tamamlandi"ya
// tasinarak islenir.
model GelistirmeTalebi {
  id          String    @id @default(cuid())
  kullaniciId String
  kullanici   Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)

  metin   String
  durumId String
  durum   SecenekDegeri @relation("GelistirmeTalebiDurumu", fields: [durumId], references: [id])

  // Claude'un konusma sirasinda GELISTIRME_KUTUSU.md + seed.ts uzerinden
  // otomatik ekledigi kartlari ikinci kez eklememek icin kullandigi sabit
  // anahtar (orn. "sutun-sirasi"). Kullanicinin panodan elle ekledigi
  // kartlarda null kalir.
  anahtar String? @unique

  olusturmaTarihi DateTime @default(now())

  @@index([kullaniciId])
  @@index([durumId])
  @@map("gelistirme_talepleri")
}

// ============================================================
// CEKIRDEK: Sol Menu Duzeni (admin tarafindan surukle-birak ile
// yeniden siralanabilir/gizlenebilir)
// ============================================================

// Bir modulun HANGI SAYFAYA gittigi, adi, "aktif mi" (henuz gelistirilmedi
// mi) hala kod tarafinda kalir (bkz. modul-kayit-defteri.ts) - bunlar bir
// gercek sayfa/route'a bagli oldugundan sadece kod degisikligiyle
// eklenebilir. Ama bir modulun HANGI SIRADA gorunecegi ve GORUNUR/GIZLI
// olup olmadigi artik admin'in kendisinin surukle-birak ile
// degistirebildigi, veritabaninda tutulan bir ayar. anahtar,
// ModulTanimi.anahtar ile eslesir; seed.ts HER deploy'da sadece eksik olan
// modulleri (kod tarafinda yeni eklenmis olabilir) varsayilan sirada ve
// gorunur olarak ekler - admin'in yaptigi siralama/gizleme degisikligine
// bir daha asla dokunmaz (bkz. GelistirmeTalebi/SecenekDegeri'ndeki ayni
// "sadece eksik olani ekle" ilkesi).
model MenuOgesi {
  id      String  @id @default(cuid())
  anahtar String  @unique
  siraNo  Int     @default(0)
  gizliMi Boolean @default(false)

  @@map("menu_ogeleri")
}

// ============================================================
// CEKIRDEK: Form Alan Duzeni (MenuOgesi ile ayni ilke, form
// alanlarina uygulanmis hali - bkz. ARCHITECTURE.md)
// ============================================================

// Bir formda HANGI ALANLARIN VAR OLDUGU (ve bunlardan hangilerinin hic
// gizlenemeyecegi) hala kod tarafinda kalir - bu, gercek bir server
// action'in veri dogrulamasina bagli. Admin'in degistirebildigi SADECE
// iki sey: alanin SIRASI ve GORUNUR/GIZLI olmasi. formAnahtari birden
// fazla formun ayni tabloyu paylasmasini saglar (orn. "dava-dosyasi").
// seed.ts HER deploy'da sadece eksik olan alanlari varsayilan sirada
// ekler, admin'in yaptigi degisikligie bir daha asla dokunmaz (bkz.
// MenuOgesi'ndeki ayni ilke).
model FormAlanDuzeni {
  id           String  @id @default(cuid())
  formAnahtari String
  alanAnahtari String
  siraNo       Int     @default(0)
  gizliMi      Boolean @default(false)

  @@unique([formAnahtari, alanAnahtari])
  @@map("form_alan_duzeni")
}

// FormAlanDuzeni ile ayni ilke: liste sayfalarindaki tablolarin sutun
// sirasi/gorunurlugu admin tarafindan degistirilebilir, seed sadece
// eksik sutunu ekler, mevcut bir satira bir daha asla dokunmaz.
model TabloSutunDuzeni {
  id            String  @id @default(cuid())
  tabloAnahtari String
  sutunAnahtari String
  siraNo        Int     @default(0)
  gizliMi       Boolean @default(false)

  @@unique([tabloAnahtari, sutunAnahtari])
  @@map("tablo_sutun_duzeni")
}

// ============================================================
// MODUL: Muvekkil Finans (V1 - bilerek BASIT)
// ============================================================
//
// Amac SADECE 5 soruya cevap vermek (bkz. ARCHITECTURE.md): musteriden ne
// kadar alindi, ne amacla, hangi dosyada gercek masraf yapildi, ne kadar
// dis kurumda, ne kadar hala bizim kontrolumuzde. Muhasebe yazilimi
// DEGIL - ledger/hesap plani/double-entry/mutabakat/banka entegrasyonu
// yok, tek bir hareket tablosu + hesaplanan bir ozet var.
//
// BILEREK MusteriParaTrafigi/ParaTrafigiTasnif/ParaTrafigiDagitimi'ndan
// TAMAMEN AYRI ve BAGIMSIZ: o mimariye (cari kod tasnifi, dosya kumesi
// dagitimi) hic dokunmuyor, hicbir FK/senkronizasyon paylasmiyor. Iki
// sistem paralel var olur; bu modul mevcut Finans/Cari Hesap ekranlarini
// degistirmez.
//
// "Islem turu" ve "para amaci" BILEREK iki ayri enum: islem turu paranin
// YONUNU/CINSINI (girdi mi, masraf mi, dis kuruma mi gitti...), para
// amaci NEDEN alindigini/harcandigini (avans mi, teminat mi...) ifade
// eder - bir PARA_GIRISI de bir MASRAF da ayni amaca (ör. MASRAF_AVANSI)
// hizmet edebilir, bu yuzden tek bir alanda birlestirilmedi.
//
// Sema yorumundaki genel ilkeden (SecenekListesi/SecenekDegeri kullan,
// enum tanimlama) BILEREK sapiliyor: bu iki liste kullanicinin verdigi
// kapali/sabit bir kume, admin panelinden genisletilebilir olmasi
// istenmiyor (KullaniciRolu enum'uyla ayni gerekce).
enum MusteriFinansIslemTuru {
  PARA_GIRISI // musteriden buroya/emanete para geldi
  MASRAF // musteri adina gercek bir harcama yapildi
  DIS_KURUMA_AKTARIM // para buronun disina (mahkeme veznesi, icra dairesi vb.) gonderildi
  DIS_KURUMDAN_IADE // dis kurumdaki para geri geldi
  MUSTERIYE_IADE // para dogrudan musteriye geri odendi

  @@map("musteri_finans_islem_turu")
}

enum MusteriFinansParaAmaci {
  MASRAF_AVANSI
  TEMINAT
  VEKALET_UCRETI
  TAHSILAT
  DIGER

  @@map("musteri_finans_para_amaci")
}

model MusteriFinansHareketi {
  id        String  @id @default(cuid())
  musteriId String
  musteri   Musteri @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  // Ileride (ör. Excel'deki eski masraf kayitlarinin ice aktarimi) bir
  // yargisal dosyaya baglanabilsin diye opsiyonel FK olarak kuruldu - V1'de
  // zorunlu degil, otomatik ice aktarim da YAPILMIYOR (bkz. ARCHITECTURE.md).
  davaDosyasiId String?
  davaDosyasi   DavaDosyasi? @relation(fields: [davaDosyasiId], references: [id])

  islemTuru MusteriFinansIslemTuru
  paraAmaci MusteriFinansParaAmaci

  tutar Decimal  @db.Decimal(14, 2)
  tarih DateTime

  aciklama String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([musteriId])
  @@index([davaDosyasiId])
  @@map("musteri_finans_hareketleri")
}

// ============================================================
// MODUL: CMK Dosyalari (bilerek BASIT, gunluk kullanim odakli)
// ============================================================
//
// CMK gorevlendirmelerinden dogan ceza dosyalarini takip eder. BILEREK
// genel DavaDosyasi/UyusmazlikGrubu/finans mimarisinden TAMAMEN AYRI: bu
// dosyalar cogunlukla henuz musteri fihristinde bile kaydi olmayan,
// mahkemenin resen atadigi supheli/saniklardir (musteriId bu yuzden
// opsiyonel) - genel dosya ekranina hic dokunulmadi, mevcut hicbir
// modelle/ekranla karistirilmiyor.
//
// "Dosya Durumu" kullanicinin verdigi kapali/sabit bir kume (8 deger) -
// MusteriFinansHareketi'ndeki islemTuru/paraAmaci ile ayni gerekceyle
// (KullaniciRolu enum'uyla ayni mantik) BILEREK native enum, SecenekDegeri
// DEGIL: admin panelinden genisletilebilir olmasi istenmiyor.
enum CMKDosyaDurumu {
  AKTIF
  DURUSMASI_BEKLENIYOR
  ISTINAF_BASVURUSU
  TEMYIZ
  DERDEST
  KARAR_VERILDI
  KESINLESTI
  KAPANDI

  @@map("cmk_dosya_durumu")
}

model CMKDosyasi {
  id String @id @default(cuid())

  // Musteri fihristinde kaydi VARSA baglanir (opsiyonel) - YOKSA (CMK
  // gorevlendirmelerinin cogunda oldugu gibi) adSoyad/telefon serbest
  // metin olarak buraya direkt girilir. Musteri silinirse bu kayit
  // SILINMEZ, sadece baglantisi kopar (onDelete: SetNull) - CMK dosyasi
  // kendi basina anlamli bir kayittir, musteri fihristine bagimli degildir.
  musteriId String?
  musteri   Musteri? @relation(fields: [musteriId], references: [id], onDelete: SetNull)

  // Her zaman dolu: musteri secilince sunucu tarafinda o musterinin
  // adiyla otomatik doldurulur (bkz. actions.ts), secilmezse kullanici
  // dogrudan yazar - liste/arama hep bu alandan hizlica calisir, join
  // gerekmez.
  adSoyad String
  telefon String?

  smsGonderilebilirMi   Boolean @default(false)
  cmkGorevlendirmeVarMi Boolean @default(true)

  suc     String
  birim   String
  dosyaNo String

  durusmaTarihi DateTime?

  dosyaDurumu CMKDosyaDurumu

  hukum       String?
  cezaMiktari String?

  sonrakiKontrolTarihi DateTime?

  notlar String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // "Ayni birim + dosyaNo yanlislikla iki kez kaydedilmesin" kurali -
  // DB seviyesinde garanti, actions.ts de bunu once dostca bir mesajla
  // (P2002 yakalanarak) kullaniciya gosterir.
  @@unique([birim, dosyaNo])
  @@index([musteriId])
  @@index([dosyaDurumu])
  @@index([durusmaTarihi])
  @@index([sonrakiKontrolTarihi])
  @@map("cmk_dosyalari")
}

// ============================================================
// MODUL GENISLETMESI: Dava Dosyasi Yasam Dongusu
// (Avukat Sapkasi + Karar Sonrasi Takip - bkz. ARCHITECTURE.md)
// ============================================================
//
// Iki ayri takip bicimi TEK bir DavaDosyasi kaydi uzerinde calisir, dosya
// hicbir sekilde kopyalanmaz/tasinmaz:
//  - "Avukat Sapkasi" (Bu dosyada avukat olarak ne yapmaliyim?) -> asagidaki
//    HukukiMudahale tablosu, EYLEM listesi.
//  - "Karar Sonrasi Takip" (Dosya nerede, ne bekleniyor?) -> DavaDosyasi'nin
//    kendi dosyaEvresi + kontrol alanlari (yukarida), GOZLEM/durum - ayri
//    bir tablo/model DEGIL, ayni kaydin bir calisma gorunumu.
//
// dosyaEvresi kapali/sabit bir is akisi (state machine) oldugu ve otomasyon
// mantigi (bkz. evre-onerileri.ts, kodlama asamasinda) bu degerler uzerinde
// dallanacagi icin BILINCLI olarak native enum - CMKDosyaDurumu/
// MusteriFinansIslemTuru ile ayni gerekce (SecenekDegeri DEGIL).
enum DosyaEvresi {
  ACILIS
  DERDEST
  KARAR_VERILDI
  GEREKCELI_KARAR_BEKLENIYOR
  GEREKCELI_KARAR_HAZIR
  TEBLIG_BEKLENIYOR
  KANUN_YOLU_DEGERLENDIRME
  ISTINAFTA
  BAM_KARARI_GELDI
  TEMYIZ_DEGERLENDIRME
  TEMYIZDE
  KESINLESME_BEKLENIYOR
  KESINLESTI

  @@map("dosya_evresi")
}

enum HukukiMudahaleDurumu {
  BEKLEMEDE
  DEVAM_EDIYOR
  TAMAMLANDI
  IPTAL_EDILDI

  @@map("hukuki_mudahale_durumu")
}

// Bir dava dosyasinda avukatin AKTIF, eyleme donuk hukuki isi (dilekce
// yazmak, degerlendirme yapmak vb.) - "Karar Sonrasi Takip" (yukaridaki
// dosyaEvresi) ile KARISTIRILMAZ: o gozlem/durum, bu eylem/gorev. Bir
// dosyanin 0-N acik mudahalesi olabilir, her biri farkli bir sorumlu
// avukata atanabilir.
model HukukiMudahale {
  id            String      @id @default(cuid())
  davaDosyasiId String
  davaDosyasi   DavaDosyasi @relation(fields: [davaDosyasiId], references: [id], onDelete: Cascade)

  baslik   String
  aciklama String?

  // Siniflandirma icin opsiyonel - her is temiz bir kategoriye girmeyebilir,
  // baslik tek basina yeterli olabilir. SecenekDegeri: buronun ihtiyaci
  // degistikce yeni tur eklenebilir (bkz. sema basindaki genel ilke).
  mudahaleTuruId String?
  mudahaleTuru   SecenekDegeri? @relation("HukukiMudahaleTuru", fields: [mudahaleTuruId], references: [id])

  durum HukukiMudahaleDurumu @default(BEKLEMEDE)

  oncelikId String?
  oncelik   SecenekDegeri? @relation("HukukiMudahaleOnceligi", fields: [oncelikId], references: [id])

  sorumluAvukatId String?
  sorumluAvukat   Kullanici? @relation("HukukiMudahaleSorumluAvukat", fields: [sorumluAvukatId], references: [id])

  sonTarih DateTime?

  olusturmaTarihi  DateTime  @default(now())
  tamamlanmaTarihi DateTime?

  @@index([davaDosyasiId])
  @@index([durum])
  @@index([sorumluAvukatId])
  @@index([sonTarih])
  @@map("hukuki_mudahaleler")
}

// Bir icra dosyasinda yapilan bir haciz isleminin kaydi. icraDosyasiId,
// DavaDosyasi'nin GENEL (tur ayrimi yapmayan) tablosuna baglanir - "İcra
// Dosyası" secimi formda tur=icra olan dosyalarla sinirlanir, ama semada
// ayri bir tablo YOK (bkz. sema basindaki genel ilke: tek DavaDosyasi
// tablosu, tur SecenekListesi ile ayirt edilir).
model HacizRaporu {
  id            String      @id @default(cuid())
  icraDosyasiId String
  icraDosyasi   DavaDosyasi @relation(fields: [icraDosyasiId], references: [id], onDelete: Cascade)

  hacizTarihi     DateTime
  islemYapan      String?
  irtibatNumarasi String?

  // Ucu, buronun ihtiyaci degistikce yeni deger eklenebilsin diye
  // SecenekListesi/SecenekDegeri ile - sema basindaki genel ilke.
  muhafazaId String?
  muhafaza   SecenekDegeri? @relation("HacizRaporuMuhafaza", fields: [muhafazaId], references: [id])

  istihkakId String?
  istihkak   SecenekDegeri? @relation("HacizRaporuIstihkak", fields: [istihkakId], references: [id])

  kiymetTakdiriId String?
  kiymetTakdiri   SecenekDegeri? @relation("HacizRaporuKiymetTakdiri", fields: [kiymetTakdiriId], references: [id])

  olusturmaTarihi DateTime @default(now())

  @@index([icraDosyasiId])
  @@index([muhafazaId])
  @@index([istihkakId])
  @@index([kiymetTakdiriId])
  @@map("haciz_raporlari")
}
