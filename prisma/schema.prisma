// KOKPIT APP - Prisma Semasi
//
// Mimari not: Bu sema iki katmandan olusur:
//   1) CEKIRDEK (Core)   - tum modullerin ortak kullandigi altyapi
//                          (kullanicilar, rolleri; genisletilebilir secenek listeleri)
//   2) MODUL             - her modul kendi tablolarini bu dosyaya ekler, ama
//                          mumkun oldugunca diger modullerin ic yapisina dogrudan
//                          FK ile baglanmaz (bkz. ARCHITECTURE.md - "gevsek baglilik").
//
// Yeni bir modul eklerken:
//   - Yeni tablolarini bu dosyanin sonuna, ayri bir "MODUL: <isim>" blogu olarak ekle.
//   - "durum", "tip" gibi kategori alanlari icin SecenekListesi/SecenekDegeri
//     desenini kullan; yeni bir enum TANIMLAMA. Yeni bir deger eklemek bir veri
//     satiri eklemek olsun, semayi degistirmek olmasin.
//   - Baska bir modulun kaydina referans gerekiyorsa (orn. "ilgili dosya"),
//     once o modul yoksa serbest metin/opsiyonel id alani olarak birak,
//     modul eklenince FK'ya (gerekirse coka-cok ara tabloya) cevir - bkz.
//     ParaTrafigiDosyasi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Vercel'in "Prisma Postgres" entegrasyonu DATABASE_URL'i otomatik olusturur
  // ve havuzlama (pooling) kendi altyapisinda halleder; ayri bir DIRECT_URL
  // gerekmez.
  url      = env("DATABASE_URL")
}

// ============================================================
// CEKIRDEK (CORE)
// ============================================================

enum KullaniciRolu {
  YONETICI // sistem yonetici - tam yetki
  ORTAK // buro ortagi
  SORUMLU_AVUKAT // dosya/musteri sorumlusu avukat
  PERSONEL // diger buro personeli

  @@map("kullanici_rolu")
}

model Kullanici {
  id               String        @id @default(cuid())
  adSoyad          String
  eposta           String        @unique
  sifreHash        String
  rol              KullaniciRolu @default(PERSONEL)
  aktifMi          Boolean       @default(true)
  olusturmaTarihi  DateTime      @default(now())
  guncellemeTarihi DateTime      @updatedAt

  sorumluOlduguMusteriler Musteri[]     @relation("MusteriSorumluAvukat")
  sorumluOlduguDosyalar   DavaDosyasi[] @relation("DavaDosyasiSorumluAvukat")
  gonderdigiOneriler      Oneri[]
  gonderdigiGelistirmeTalepleri GelistirmeTalebi[]

  @@map("kullanicilar")
}

// Genisletilebilir liste/etiket altyapisi.
// "durum", "tip", "kaynak" gibi kategori alanlari icin kullanilir; boylece
// yeni bir deger eklemek (orn. "kismi tahsilat") semayi bozmadan, sadece
// yeni bir SecenekDegeri satiri eklemekle yapilir.
model SecenekListesi {
  id       String  @id @default(cuid())
  anahtar  String  @unique // orn. "musteri_tipi", "musteri_durumu", "para_trafigi_tipi"
  ad       String // insan-okunur ad, orn. "Musteri Tipi"
  aciklama String?

  degerler SecenekDegeri[]

  @@map("secenek_listeleri")
}

model SecenekDegeri {
  id              String         @id @default(cuid())
  listeId         String
  liste           SecenekListesi @relation(fields: [listeId], references: [id], onDelete: Cascade)
  kod             String // makine-okunur anahtar, orn. "gercek_kisi"
  etiket          String // ekranda gosterilen ad, orn. "Gerçek Kişi"
  siraNo          Int            @default(0)
  aktifMi         Boolean        @default(true)
  olusturmaTarihi DateTime       @default(now())

  musterilerTip     Musteri[]            @relation("MusteriTipi")
  musterilerDurum   Musteri[]            @relation("MusteriDurumu")
  paraTrafigiTip    MusteriParaTrafigi[] @relation("ParaTrafigiTipi")
  paraTrafigiDurum  MusteriParaTrafigi[] @relation("ParaTrafigiDurumu")
  paraTrafigiKaynak MusteriParaTrafigi[] @relation("ParaTrafigiKaynagi")
  davaDosyalariDurum DavaDosyasi[]       @relation("DavaDosyasiDurumu")
  davaDosyalariTuru  DavaDosyasi[]       @relation("DavaDosyasiTuru")
  davaDosyalariHukukiIliskiTuru DavaDosyasi[] @relation("DavaDosyasiHukukiIliskiTuru")
  paraTrafigiTasnifCariKod ParaTrafigiTasnif[] @relation("ParaTrafigiTasnifCariKod")
  dosyaMasrafiCariKod DosyaMasrafi[] @relation("DosyaMasrafiCariKod")
  dosyaMasrafiTuru    DosyaMasrafi[] @relation("DosyaMasrafiTuru")
  gelistirmeTalepleriDurum GelistirmeTalebi[] @relation("GelistirmeTalebiDurumu")

  @@unique([listeId, kod])
  @@map("secenek_degerleri")
}

// ============================================================
// MODUL: Musteri Veritabani (Müvekkil İlişkileri)
// ============================================================

// Musteri Fihristi
model Musteri {
  id               String        @id @default(cuid())
  adSoyadUnvan     String
  tipId            String
  tip              SecenekDegeri @relation("MusteriTipi", fields: [tipId], references: [id])
  telefon          String?
  eposta           String?
  adres            String?
  durumId          String
  durum            SecenekDegeri @relation("MusteriDurumu", fields: [durumId], references: [id])
  sorumluAvukatId  String?
  sorumluAvukat    Kullanici?    @relation("MusteriSorumluAvukat", fields: [sorumluAvukatId], references: [id])
  notlar           String?
  olusturmaTarihi  DateTime      @default(now())
  guncellemeTarihi DateTime      @updatedAt

  paraTrafigi        MusteriParaTrafigi[]
  dosyalar           DosyaMuvekkili[]
  irtibatKisileri    IrtibatKisisi[]
  karsiTaraflar      KarsiTaraf[]
  uyusmazlikGruplari UyusmazlikGrubu[]

  @@index([durumId])
  @@index([sorumluAvukatId])
  @@map("musteriler")
}

// Musterinin (ozellikle tuzel kisilerin) irtibat kisileri/temsilcileri.
// Hangi konuda hangi kisiyle irtibata gecilecegini kayit altina alir;
// telefon/e-posta gibi iletisim bilgileri her zaman bir kisiye bagli
// tutulur, boylece "bu numara/e-posta kime ait" belirsizligi olmaz.
model IrtibatKisisi {
  id        String  @id @default(cuid())
  musteriId String
  musteri   Musteri @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  adSoyad     String
  unvanGorev  String? // "Genel Müdür", "Muhasebe Sorumlusu" vb.
  konuBasligi String? // hangi konularda irtibat kurulmali - "Sözleşme onayları" vb.
  telefon     String?
  eposta      String?
  birincilMi  Boolean @default(false) // ilk/asil irtibat kisisi mi
  notlar      String?

  olusturmaTarihi DateTime @default(now())

  @@index([musteriId])
  @@map("irtibat_kisileri")
}

// Musteri Para Trafigi (Musteri Fihristi'ne bagli, 1 musteri -> cok kayit)
// Ileride Finans/Muhasebe modulune dogrudan baglanacak sekilde tasarlandi.
model MusteriParaTrafigi {
  id        String  @id @default(cuid())
  musteriId String
  musteri   Musteri @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  tarih    DateTime
  tipId    String
  tip      SecenekDegeri @relation("ParaTrafigiTipi", fields: [tipId], references: [id])
  tutar    Decimal       @db.Decimal(14, 2)
  aciklama String?

  durumId String
  durum   SecenekDegeri @relation("ParaTrafigiDurumu", fields: [durumId], references: [id])

  // manuel / uyap_import / objekt - ileride toplu import icin
  kaynakId String
  kaynak   SecenekDegeri @relation("ParaTrafigiKaynagi", fields: [kaynakId], references: [id])

  // Bir kayit (orn. bir tahsilat) birden fazla dava dosyasina istinaden
  // gelmis olabilir (bazen tek, bazen cok dosya soz konusu olur) - bkz.
  // ParaTrafigiDosyasi ara tablosu.
  dosyalar ParaTrafigiDosyasi[]

  // Musterinin ayirt edici unsuru (ör. "Asya Park Ticareti") - opsiyonel.
  // Musteriden gelen bir para her zaman somut bir dava dosyasina
  // baglanabilecek durumda olmayabilir (henuz dosya acilmamis olabilir),
  // ama HANGI ticari iliskiye/uyusmazliga ait oldugu bilinebilir. Bu alan
  // dosya secimi olmadan da grubun cari hesabina dahil olmayi saglar.
  uyusmazlikGrubuId String?
  uyusmazlikGrubu   UyusmazlikGrubu? @relation(fields: [uyusmazlikGrubuId], references: [id])

  // Gelen tutarin cari kodlara (Bloke Paralar / Masraf Hesabi / Akdi Vekalet
  // Hesabi / Ticari Hesap vb.) nasil dagitildigi - bkz. ParaTrafigiTasnif.
  tasnif ParaTrafigiTasnif[]

  olusturmaTarihi DateTime @default(now())

  @@index([musteriId])
  @@index([durumId])
  @@index([uyusmazlikGrubuId])
  @@map("musteri_para_trafigi")
}

// Bir para trafigi kaydinin (ozellikle bir tahsilatin) cari kodlara gore
// tasnifi/dagitimi. Orn. 330.000 TL'lik bir tahsilat; 285.000 Bloke Paralar,
// 30.000 Masraf Hesabi, 15.000 Akdi Vekalet Hesabi olarak boluneilir. Toplam,
// kaydin tutariyla mutabik olmak ZORUNDA degil (UI'da kontrol/uyari olarak
// gosterilir) - gercek hayatta tasnif sonradan da tamamlanabilir.
model ParaTrafigiTasnif {
  id            String             @id @default(cuid())
  paraTrafigiId String
  paraTrafigi   MusteriParaTrafigi @relation(fields: [paraTrafigiId], references: [id], onDelete: Cascade)
  cariKodId     String
  cariKod       SecenekDegeri      @relation("ParaTrafigiTasnifCariKod", fields: [cariKodId], references: [id])
  tutar         Decimal            @db.Decimal(14, 2)

  olusturmaTarihi DateTime @default(now())

  @@unique([paraTrafigiId, cariKodId])
  @@index([cariKodId])
  @@map("para_trafigi_tasnif")
}

// MusteriParaTrafigi <-> DavaDosyasi coka-cok iliski (ara) tablosu. Ileride
// "tasnif" adimi bu satirlara dosya basina tutar/pay eklenerek genisleyebilir.
model ParaTrafigiDosyasi {
  id            String             @id @default(cuid())
  paraTrafigiId String
  paraTrafigi   MusteriParaTrafigi @relation(fields: [paraTrafigiId], references: [id], onDelete: Cascade)
  dosyaId       String
  dosya         DavaDosyasi        @relation(fields: [dosyaId], references: [id], onDelete: Cascade)

  olusturmaTarihi DateTime @default(now())

  @@unique([paraTrafigiId, dosyaId])
  @@index([dosyaId])
  @@map("para_trafigi_dosyalari")
}

// ============================================================
// MODUL: Dava Dosyalari
// ============================================================

// Musterinin (muvekkilin) KENDI musterisi/borclusu - buronun muvekkil adina
// icra/dava takip ettigi karsi taraf (orn. "Koz Gida", "Nasip Sac"). Musteri
// (muvekkil) ile KARISTIRILMAMALI - bkz. ARCHITECTURE.md "Finans Modulu"
// bolumu. Bir karsi tarafa birden fazla dava dosyasi baglanabilir.
model KarsiTaraf {
  id        String  @id @default(cuid())
  musteriId String
  musteri   Musteri @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  ad             String
  tanimlayiciKod String? // MAK: cek no, VKN vb. - simdilik serbest metin (bkz. ARCHITECTURE.md)
  notlar         String?

  olusturmaTarihi DateTime @default(now())

  dosyalar DosyaKarsiTarafi[]

  @@index([musteriId])
  @@map("karsi_taraflar")
}

// DavaDosyasi <-> KarsiTaraf coka-cok ara tablosu (DosyaMuvekkili ile
// aynı desen). Bir icra takibi genelde TEK bir karsi tarafa degil, cek/
// bono zincirindeki TUM muteselsil sorumlulara (kesideci + cirantalar)
// birden acilir - ayni esas dosyada birden fazla borclu birlikte takip
// edilir (bkz. ARCHITECTURE.md).
model DosyaKarsiTarafi {
  id           String      @id @default(cuid())
  dosyaId      String
  dosya        DavaDosyasi @relation(fields: [dosyaId], references: [id], onDelete: Cascade)
  karsiTarafId String
  karsiTaraf   KarsiTaraf  @relation(fields: [karsiTarafId], references: [id], onDelete: Cascade)

  olusturmaTarihi DateTime @default(now())

  @@unique([dosyaId, karsiTarafId])
  @@index([karsiTarafId])
  @@map("dosya_karsi_taraflari")
}

// Ayni alacagin/uyusmazligin tahsili icin birden fazla karsi taraf ve dosya
// gerekebilir (orn. asil borclu + sonradan devreye giren kefil/senet
// dosyasi, "tekerrur olmasin" notuyla birbirine bagli). UyusmazlikGrubu bu
// ust gruplamayi temsil eder: "Asya Park Ticareti" gibi tek bir kok
// alacak/uyusmazlik, altinda birden fazla Uyusmazlik Dosyasi (DavaDosyasi)
// barindirabilir.
model UyusmazlikGrubu {
  id        String  @id @default(cuid())
  musteriId String
  musteri   Musteri @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  ad     String // "Asya Park Ticareti", "Hicret Kırtay İş Sözleşmesi" vb.
  notlar String?

  olusturmaTarihi DateTime @default(now())

  dosyalar             DavaDosyasi[]
  paraTrafigiKayitlari MusteriParaTrafigi[]

  @@index([musteriId])
  @@map("uyusmazlik_gruplari")
}

// Bir dava dosyasina birden fazla musteri baglanabilir (ortak davacilar,
// veraset vb.); bu yuzden Musteri <-> DavaDosyasi iliskisi DosyaMuvekkili
// ara tablosu uzerinden coka-cok kurulur (bkz. semanin en ustundeki not).
model DavaDosyasi {
  id                String           @id @default(cuid())
  // Kokpit'in kendi ic kayit numarasi - "Dosya No" (mahkeme/icra
  // dairesinin verdigi esas no) artik opsiyonel oldugu icin, HER dosyanin
  // (turu ne olursa olsun - ihtar/muzakere/icra/dava) sistemde her zaman
  // sahip oldugu, otomatik atanan, sirali bir kimlik numarasi. Kullanicinin
  // girmesi gerekmez, "Kokpit No" olarak gosterilir (ör. "KP-0007").
  kayitNo           Int              @unique @default(autoincrement())
  dosyaNo           String?
  birimAdi          String? // Mahkeme/Icra Dairesi adi, orn. "Istanbul 19. Icra Dairesi"
  konu              String
  // Dosya turu: ihtar/arabuluculuk/muzakere gibi dava/icra oncesi
  // asamalari da, esas icra/talimat/dava/icra ceza gibi resmi dosyalari da
  // kapsayan tek bir secenek listesi (bkz. ARCHITECTURE.md). Nullable:
  // eski kayitlar geriye donuk turlendirilene kadar bos kalabilir, ama
  // yeni dosya formunda zorunlu tutulur.
  turId             String?
  tur               SecenekDegeri?   @relation("DavaDosyasiTuru", fields: [turId], references: [id])
  // Alacagin/uyusmazligin dayandigi temel hukuki iliski: cek, senet, TTOK,
  // is hukuku uyusmazligi vb. Dosya Turu'nden (ihtar/icra/dava - hangi
  // ASAMADAYIZ) farkli bir boyut: bu "hangi hukuki ARACA dayaniyor" sorusuna
  // cevap verir. Opsiyonel - her dosyaya uygulanabilir bir siniflandirma
  // olmayabilir.
  hukukiIliskiTuruId String?
  hukukiIliskiTuru   SecenekDegeri?   @relation("DavaDosyasiHukukiIliskiTuru", fields: [hukukiIliskiTuruId], references: [id])
  uyusmazlikGrubuId String?
  uyusmazlikGrubu   UyusmazlikGrubu? @relation(fields: [uyusmazlikGrubuId], references: [id])
  // Talimat dosyasi gibi baska bir dosyaya siki sikiya bagli (o dosyanin
  // bir uzantisi olan) dosyalar icin: hangi ESAS dosyaya bagli oldugu.
  // UyusmazlikGrubu'ndan farki: grup gevsek bir gruplamadir (ayni alacagin
  // bagimsiz kardes dosyalari - icra ceza, ihtiyati haciz vb.), bu alan ise
  // "bu dosya somut olarak şu belirli dosyanin bir eki/talimatidir" gibi
  // kesin, tekil bir bagi ifade eder.
  bagliOlduguDosyaId String?
  bagliOlduguDosya   DavaDosyasi?  @relation("DosyaBaglantisi", fields: [bagliOlduguDosyaId], references: [id])
  baglananDosyalar   DavaDosyasi[] @relation("DosyaBaglantisi")
  durumId           String
  durum             SecenekDegeri    @relation("DavaDosyasiDurumu", fields: [durumId], references: [id])
  sorumluAvukatId   String?
  sorumluAvukat     Kullanici?       @relation("DavaDosyasiSorumluAvukat", fields: [sorumluAvukatId], references: [id])
  acilisTarihi      DateTime
  kapanisTarihi     DateTime?
  aciklama          String?
  olusturmaTarihi   DateTime         @default(now())
  guncellemeTarihi  DateTime         @updatedAt

  muvekkiller          DosyaMuvekkili[]
  karsiTaraflar        DosyaKarsiTarafi[]
  paraTrafigiKayitlari ParaTrafigiDosyasi[]
  masraflar            DosyaMasrafi[]
  karsiTarafAlacaklari KarsiTarafAlacagi[]

  @@index([durumId])
  @@index([sorumluAvukatId])
  @@index([uyusmazlikGrubuId])
  @@index([bagliOlduguDosyaId])
  @@index([turId])
  @@index([hukukiIliskiTuruId])
  @@map("dava_dosyalari")
}

// Muvekkilden gelen para (tasnif/masraf sistemi) ile KARISTIRILMAMALI: bu,
// karsi tarafin (borclunun) dava/icra sonucu bize/muvekkile ayrica
// odemesi gereken bir alacaktir (ör. icra vekalet ucreti, yargilama
// gideri) - cebimizden hicbir sey cikmaz, tersine karsi taraftan bir
// tahsilat beklenir. Muvekkil emanet/cari hesabindan (ParaTrafigiTasnif/
// DosyaMasrafi) BILEREK ayri tutulur (bkz. ARCHITECTURE.md); evrensel
// hukuk burosu pratiginde musteri emanet hesabi (trust account) ile
// buronun/musvekkilin ucuncu taraflardan alacagi hep ayri muhasebelesir.
model KarsiTarafAlacagi {
  id      String      @id @default(cuid())
  dosyaId String
  dosya   DavaDosyasi @relation(fields: [dosyaId], references: [id], onDelete: Cascade)

  tutar    Decimal @db.Decimal(14, 2)
  aciklama String // "İcra vekalet ücreti" vb.

  tahsilEdildiMi Boolean   @default(false)
  tahsilTarihi   DateTime?

  olusturmaTarihi DateTime @default(now())

  @@index([dosyaId])
  @@map("karsi_taraf_alacaklari")
}

// Bir dosyaya iliskin tek tek masraf kalemleri (harc, pul, dava masrafi,
// haciz avansi vb.) - gercek muhasebe dokumlerindeki kalem-kalem yapiyi
// birebir yansitir, boylece muvekkile "paranin nereye gittigi" satir
// satir gosterilebilir. Her kalem, o dosyanin hangi cari koddan
// (Masraf Hesabi, Bloke Paralar vb.) dusuldugunu de tasir.
model DosyaMasrafi {
  id        String        @id @default(cuid())
  dosyaId   String
  dosya     DavaDosyasi   @relation(fields: [dosyaId], references: [id], onDelete: Cascade)
  cariKodId String
  cariKod   SecenekDegeri @relation("DosyaMasrafiCariKod", fields: [cariKodId], references: [id])
  turId     String
  tur       SecenekDegeri @relation("DosyaMasrafiTuru", fields: [turId], references: [id])

  tarih    DateTime
  aciklama String
  tutar    Decimal  @db.Decimal(14, 2)

  olusturmaTarihi DateTime @default(now())

  @@index([dosyaId])
  @@index([cariKodId])
  @@index([turId])
  @@map("dosya_masraflari")
}

// Musteri <-> DavaDosyasi coka-cok iliski (ara) tablosu.
model DosyaMuvekkili {
  id        String      @id @default(cuid())
  dosyaId   String
  dosya     DavaDosyasi @relation(fields: [dosyaId], references: [id], onDelete: Cascade)
  musteriId String
  musteri   Musteri     @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  olusturmaTarihi DateTime @default(now())

  @@unique([dosyaId, musteriId])
  @@index([musteriId])
  @@map("dosya_muvekkilleri")
}

// ============================================================
// CEKIRDEK: Sayfa Onerileri (Geri Bildirim)
// ============================================================

// Kullanicinin herhangi bir sayfada bir bolge secip kisa bir aciklamayla
// gonderdigi tasarim/veri onerisi. Yonetici/Ortak rolunun gonderdigi
// oneriler dogrudan hayata gecirilir; diger roller gonderdiginde
// yoneticiye onay icin sorulur (bkz. ARCHITECTURE.md).
model Oneri {
  id          String    @id @default(cuid())
  kullaniciId String
  kullanici   Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)

  metin     String
  sayfaYolu String
  gorselVeri String? // secilen bolgenin ekran goruntusu (data:image/jpeg;base64,...)
  islendiMi Boolean @default(false)

  olusturmaTarihi DateTime @default(now())

  @@index([kullaniciId])
  @@map("oneriler")
}

// ============================================================
// CEKIRDEK: Gelistirici Kutusu (Developer Inbox)
// ============================================================

// Musteri (av. Bora) ile Claude arasindaki gelistirme sohbetinde soylenen
// her istek/fikrin, kod yazilmadan once hemen kaydedildigi basit bir
// bekleme listesi. Oneri modelinden farki: ekran goruntusu/bolge secimi
// gerektirmez, sadece kisa bir metin - konusma sirasinda hizlica not
// dusmek icindir. Sira sira, durumu "beklemede"den "tamamlandi"ya
// tasinarak islenir.
model GelistirmeTalebi {
  id          String    @id @default(cuid())
  kullaniciId String
  kullanici   Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)

  metin   String
  durumId String
  durum   SecenekDegeri @relation("GelistirmeTalebiDurumu", fields: [durumId], references: [id])

  // Claude'un konusma sirasinda GELISTIRME_KUTUSU.md + seed.ts uzerinden
  // otomatik ekledigi kartlari ikinci kez eklememek icin kullandigi sabit
  // anahtar (orn. "sutun-sirasi"). Kullanicinin panodan elle ekledigi
  // kartlarda null kalir.
  anahtar String? @unique

  olusturmaTarihi DateTime @default(now())

  @@index([kullaniciId])
  @@index([durumId])
  @@map("gelistirme_talepleri")
}

// ============================================================
// CEKIRDEK: Sol Menu Duzeni (admin tarafindan surukle-birak ile
// yeniden siralanabilir/gizlenebilir)
// ============================================================

// Bir modulun HANGI SAYFAYA gittigi, adi, "aktif mi" (henuz gelistirilmedi
// mi) hala kod tarafinda kalir (bkz. modul-kayit-defteri.ts) - bunlar bir
// gercek sayfa/route'a bagli oldugundan sadece kod degisikligiyle
// eklenebilir. Ama bir modulun HANGI SIRADA gorunecegi ve GORUNUR/GIZLI
// olup olmadigi artik admin'in kendisinin surukle-birak ile
// degistirebildigi, veritabaninda tutulan bir ayar. anahtar,
// ModulTanimi.anahtar ile eslesir; seed.ts HER deploy'da sadece eksik olan
// modulleri (kod tarafinda yeni eklenmis olabilir) varsayilan sirada ve
// gorunur olarak ekler - admin'in yaptigi siralama/gizleme degisikligine
// bir daha asla dokunmaz (bkz. GelistirmeTalebi/SecenekDegeri'ndeki ayni
// "sadece eksik olani ekle" ilkesi).
model MenuOgesi {
  id      String  @id @default(cuid())
  anahtar String  @unique
  siraNo  Int     @default(0)
  gizliMi Boolean @default(false)

  @@map("menu_ogeleri")
}
