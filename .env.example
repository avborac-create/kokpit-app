# Veritabani baglanti dizesi (Postgres)
# Yerelde tek bir Postgres kullaniyorsaniz DATABASE_URL ve DIRECT_URL ayni olabilir.
# Neon/Supabase gibi havuzlamali (pooled) bir saglayici kullaniyorsaniz:
#   DATABASE_URL -> havuzlanmis baglanti (uygulama bunu kullanir)
#   DIRECT_URL   -> havuzsuz dogrudan baglanti (sadece `prisma migrate` bunu kullanir)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kokpit_app?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/kokpit_app?schema=public"

# Oturum (session) imzalama anahtari - uretimde `openssl rand -base64 32` ile uretin
SESSION_SECRET="change-me"
