# Veritabani baglanti dizesi (Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kokpit_app?schema=public"

# Oturum (session) imzalama anahtari - uretimde `openssl rand -base64 32` ile uretin
SESSION_SECRET="change-me"

# Haciz raporu bildirim e-postalari icin (resend.com'dan alinir) - tanimli
# degilse bildirim SESSIZCE atlanir, haciz raporu kaydi etkilenmez.
RESEND_API_KEY=""

# Bildirim e-postalarinin "gonderen" adresi - eceshukuk.com Resend'de
# dogrulanmis bir domain olarak eklenene kadar varsayilan (Resend'in kendi
# sandbox adresi) kullanilir.
HACIZ_RAPORU_BILDIRIM_GONDEREN="Kokpit <onboarding@resend.dev>"
